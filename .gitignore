.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/
CLAUDE.local.md
# Fetched reference material and test data (tools/fetch_testdata.py); never tracked.
external/
# Build output.
dist/
build/
*.egg-info/
# tools/write_commit.py's build-time output: the commit a wheel or the .exe was built
# from, written before every build and never tracked. A checkout has none and answers
# from git instead (lab record, task 20).
src/mainspring/_commit.py
# Numba's on-disk JIT cache when it lands beside the source.
__nb_cache__/
# tools/warm_numba_cache.py's build-time output, bundled into the .exe by
# packaging/mainspring.spec; regenerated before every build, never tracked.
packaging/numba_cache_seed/
# No acquisition ever enters the code repo: sample files live in the lab repo
# (../mainspring-lab/data/), and the pre-commit hook refuses the path as well.
*.uimf
*.uimf-journal
